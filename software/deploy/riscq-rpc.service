# ZCU216 BoardServer service. Install /etc/riscq/zcu216.env before enabling the unit.
[Unit]
Description=RISC-Q ZCU216 board server (Pyro5)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/riscq/zcu216.env
ExecStart=/usr/bin/python3 -m riscq.board.server --bits /opt/riscq/zcu216-bits --bundle ${RISCQ_ZCU216_BUNDLE} --host ${RISCQ_ZCU216_BIND} --port ${RISCQ_ZCU216_PORT}
Restart=on-failure
User=root

[Install]
WantedBy=multi-user.target
