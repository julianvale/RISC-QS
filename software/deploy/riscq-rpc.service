# Legacy-compatible ZCU216 Pyro service.
#
# This unit is intentionally ZCU216-only. It starts the preserved riscq.board.server /
# riscq.driver.remote workflow and is not the newer authenticated deployment service.
# Install /etc/riscq/zcu216.env first; see docs/software/11-zcu216-setup.md.
[Unit]
Description=RISC-Q legacy ZCU216 board server (Pyro5)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/riscq/zcu216.env
ExecStart=/usr/bin/python3 -m riscq.board.server --bits /opt/riscq/zcu216-bits --bundle ${RISCQ_ZCU216_BUNDLE} --host ${RISCQ_ZCU216_BIND} --port ${RISCQ_ZCU216_PORT}
Restart=on-failure
User=root

[Install]
WantedBy=multi-user.target
